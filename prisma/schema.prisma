// NSUDE data model. MongoDB via Prisma 6 (Prisma's MongoDB connector).
// Run `npm run db:push` after changing this file to sync indexes, and
// `npm run db:generate` to refresh the typed client.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

/// An image stored in Cloudinary. `publicId` is Cloudinary's id, used to
/// delete the asset when it's removed; it's empty for external URLs
/// (e.g. the seeded Unsplash placeholders).
type Image {
  src      String
  alt      String  @default("")
  publicId String?
  width    Int?
  height   Int?
}

/// One colorway of a product. Each color has its own photos, stock and
/// sold-out sizes, and is listed as its own card in the shop.
type ColorVariant {
  name             String
  /// Public product code, e.g. "7K2Q": 4+ uppercase letters/digits, unique
  /// across the whole store and never changed once assigned. The product
  /// page URL is /product/<code>.
  code             String
  hex              String
  images           Image[]
  stock            Int      @default(0)
  /// Subset of the product's `sizes` that are sold out in this color.
  unavailableSizes String[]
  /// Per-size prices for this color (whole rupees). A missing size uses
  /// the product's base `price`.
  sizePrices       SizePrices?
}

type SizePrices {
  S   Int?
  M   Int?
  L   Int?
  XL  Int?
  XXL Int?
}

type SizeValues {
  S   String @default("")
  M   String @default("")
  L   String @default("")
  XL  String @default("")
  XXL String @default("")
}

type Measurement {
  label  String
  values SizeValues
}

model Product {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  /// Base price in whole rupees (INR), used for every color and size that
  /// doesn't set its own price in `variants[].sizePrices`.
  price          Int
  compareAtPrice Int?
  description    String
  story          String         @default("")
  /// Colorways, in display order. The first is the default color.
  variants       ColorVariant[]
  /// Sizes this product is made in; subset of S, M, L, XL, XXL.
  sizes          String[]
  /// "T-Shirts" | "Long Sleeve"
  category       String
  material       String         @default("")
  /// "Slim" | "Regular" | "Relaxed" | "Oversized" | "Boxy"
  fit            String
  weight         String         @default("")
  featured       Boolean        @default(false)
  newArrival     Boolean        @default(false)
  measurements   Measurement[]
  heroSlides     HeroSlide[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // No two colorways in different products may share a code. (Within one
  // product the API guarantees it, since a unique multikey index can't.)
  @@unique([variants.code])
}

/// One t-shirt in the home hero carousel: a transparent cutout image that
/// links to a product. Shown in ascending `position` order.
model HeroSlide {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  position  Int
  image     Image
  productId String   @db.ObjectId
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
}

/// A colorway's swatch, for the "other colors" dots on a product card.
type Swatch {
  code String
  name String
  hex  String
}

/// Read model for the shop: one lean document per colorway, holding only
/// what a product card and the shop filters need. Derived from Product —
/// never edited directly; rebuilt whenever a product is saved or deleted
/// (see src/lib/server/listings.ts). Lets the shop filter, sort, count and
/// paginate thousands of colorways with indexed queries instead of loading
/// the whole catalog.
model Listing {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  /// The colorway's product code (the page URL is /product/<code>).
  code             String   @unique
  productId        String   @db.ObjectId
  /// Colorway order within its product (0 = default color).
  position         Int
  productName      String
  colorName        String
  /// URL-safe color key for filtering, e.g. "off-white".
  colorKey         String
  hex              String
  category         String
  fit              String
  /// Sizes that can be bought in this color right now.
  availableSizes   String[]
  inStock          Boolean
  priceMin         Int
  priceMax         Int
  /// First two photos (main + hover).
  images           Image[]
  swatches         Swatch[]
  featured         Boolean
  newArrival       Boolean
  productCreatedAt DateTime
  /// Lowercased "name color fit category" for search.
  searchText       String

  @@index([productId])
  @@index([category])
  @@index([fit])
  @@index([colorKey])
  @@index([priceMin])
  @@index([featured, productCreatedAt])
  @@index([newArrival, productCreatedAt])
}

/// A line in an order: a snapshot of what was bought, at the price charged
/// (later product edits never change past orders).
type OrderItem {
  productId String @db.ObjectId
  /// Colorway product code, e.g. "7K2Q".
  code      String
  name      String
  color     String
  size      String
  /// Unit price in whole rupees, computed on the server at checkout.
  price     Int
  quantity  Int
  image     String @default("")
}

type ShippingAddress {
  firstName String
  lastName  String
  line1     String
  line2     String @default("")
  city      String
  state     String
  pincode   String
  country   String @default("India")
}

/// A customer order (guest checkout). Prices and totals are computed on the
/// server from the catalog; the bag in the browser only says what to buy.
model Order {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  /// Customer-facing order number, e.g. "NS-7K2Q9X".
  number          String          @unique
  /// "pending_payment" (waiting for Razorpay) | "placed" | "shipped" |
  /// "delivered" | "cancelled"
  status          String
  /// "razorpay" | "cod"
  paymentMethod   String
  /// "pending" | "paid" | "failed" | "cod" (collected on delivery)
  paymentStatus   String
  razorpayOrderId   String?
  razorpayPaymentId String?
  items           OrderItem[]
  subtotal        Int
  shipping        Int
  total           Int
  email           String
  phone           String
  address         ShippingAddress
  /// True while this order holds stock. Set when stock is taken at
  /// checkout; cleared when a cancelled / abandoned order gives it back.
  stockHeld       Boolean         @default(false)
  /// The signed-in customer who placed it (null for guest checkout).
  customerId      String?         @db.ObjectId
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status, createdAt])
  @@index([razorpayOrderId])
  @@index([createdAt])
  @@index([customerId, createdAt])
  @@index([phone, createdAt])
}

/// A delivery address saved on a customer account.
type SavedAddress {
  /// Random id, so one address can be edited or removed.
  id        String
  firstName String
  lastName  String
  line1     String
  line2     String @default("")
  city      String
  state     String
  pincode   String
}

/// A customer account. Customers sign in (and sign up) with their mobile
/// number and a one-time code — there are no passwords.
model Customer {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  /// 10-digit Indian mobile number (no +91), verified by OTP.
  phone            String         @unique
  name             String         @default("")
  email            String         @default("")
  addresses        SavedAddress[]
  defaultAddressId String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

/// A one-time login code. Only a hash is stored; it expires after a few
/// minutes and allows a handful of wrong attempts.
model OtpCode {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
}

/// A customer's login on one device. The browser holds a short-lived access
/// token (1 hour) and a long-lived refresh token (30 days from last use);
/// only a hash of the refresh token is stored. Every refresh rotates it, and
/// re-using an old one ends the session (it may have been stolen).
model CustomerSession {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  customerId        String    @db.ObjectId
  tokenHash         String    @unique
  /// The token this one replaced, accepted only for a few seconds after a
  /// rotation (two tabs refreshing at once); later use ends the session.
  previousTokenHash String?
  rotatedAt         DateTime?
  expiresAt         DateTime
  lastUsedAt        DateTime  @default(now())
  userAgent         String    @default("")
  createdAt         DateTime  @default(now())

  @@index([customerId])
  @@index([previousTokenHash])
  @@index([expiresAt])
}

/// One field that changed in an edit: its old and new value, as display text.
type AuditChange {
  field String
  from  String @default("")
  to    String @default("")
}

/// Edit history for the whole store: every change to a customer account,
/// product, hero slide or order — who did it, when, and old → new values.
/// Append-only; shown to admins only.
model AuditLog {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  at          DateTime      @default(now())
  /// "customer" | "admin" | "system"
  actorType   String
  /// Admin email, or "+91 …" for a customer, or e.g. "Payment check".
  actorLabel  String
  /// "customer" | "product" | "hero" | "order"
  entity      String
  entityId    String
  /// Human name of the thing changed (product name, order number, phone…).
  entityLabel String
  /// What happened, e.g. "Account created", "Address edited", "Product updated".
  action      String
  changes     AuditChange[]

  @@index([at])
  @@index([entity, entityId, at])
}

/// People who can sign in to admin, besides the superadmin in .env.
/// What each can see or change is in `permissions` (see lib/adminPermissions).
model AdminUser {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  email          String    @unique
  name           String
  /// scrypt hash, never the password itself.
  passwordHash   String
  /// e.g. ["orders.view", "products.manage"]
  permissions    String[]
  active         Boolean   @default(true)
  /// Bumped on password change; older sessions stop working.
  sessionVersion Int       @default(0)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

/// One visit: from the first page to the last, until 30 minutes without
/// activity — a shopper on the storefront, or an admin user in the panel. Browsing before sign-in is linked to the customer once
/// they sign in on the same device.
model VisitSession {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  /// Random id from the browser (cookie), unique per visit.
  key           String    @unique
  /// Random id per browser (1-year cookie); ties visits from one device.
  visitorId     String
  /// "store" (shoppers) or "admin" (admin users in the admin panel).
  area          String    @default("store")
  customerId    String?   @db.ObjectId
  /// The admin user, for admin visits.
  adminEmail    String?
  startedAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  landingPath   String
  exitPath      String
  referrer      String?
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  /// "mobile" | "tablet" | "desktop"
  device        String
  browser       String
  os            String
  screen        String?
  language      String?
  pageViews     Int       @default(0)
  eventCount    Int       @default(0)
  addedToBag    Boolean   @default(false)
  reachedCheckout Boolean @default(false)
  orderNumbers  String[]
  /// Deleted by a MongoDB TTL index after the retention period.
  expiresAt     DateTime

  @@index([visitorId, startedAt])
  @@index([customerId, startedAt])
  @@index([area, startedAt])
  @@index([adminEmail, startedAt])
  @@index([lastSeenAt])
}

/// Something a visitor did: viewed a page, clicked, picked a size, added to
/// bag, searched, placed an order… Never stores what was typed into forms.
model ActivityEvent {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionKey String
  visitorId  String
  /// "store" or "admin", as on the visit.
  area       String   @default("store")
  customerId String?  @db.ObjectId
  at         DateTime @default(now())
  /// e.g. "page_view", "click", "add_to_bag", "order_placed"
  type       String
  path       String
  /// Small key → value details (product code, size, label, query…).
  data       Json?
  /// "client" (browser) or "server" (confirmed by the server).
  source     String   @default("client")
  expiresAt  DateTime

  @@index([sessionKey, at])
  @@index([customerId, at])
  @@index([type, at])
}
