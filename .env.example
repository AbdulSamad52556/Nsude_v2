# Copy to .env and fill in. Never commit .env.

# MongoDB Atlas connection string (Prisma needs the database name after .net/)
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/nsude?retryWrites=true&w=majority&appName=Cluster0"

# Cloudinary (Settings → API Keys)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Superadmin login for /admin
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="use-a-long-random-password"

# Signs admin session cookies — 32+ random characters, e.g.
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# Razorpay (Dashboard → Account & Settings → API Keys). Use test keys
# (rzp_test_…) while developing; leave empty to offer cash on delivery only.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Optional: Dashboard → Webhooks → URL https://<your-domain>/api/webhooks/razorpay,
# event "payment.captured", and the same secret here.
RAZORPAY_WEBHOOK_SECRET=""

# Customer login is by mobile number + one-time code (no passwords).
# SMS provider for the codes. Leave empty while developing: codes are then
# printed in the server terminal and shown on the login screen. The live site
# refuses to send codes until a real provider is configured here.
SMS_PROVIDER=""
