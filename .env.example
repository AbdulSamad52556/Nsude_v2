# Copy to .env and fill in. Never commit .env.

# MongoDB Atlas connection string (Prisma needs the database name after .net/)
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/nsude?retryWrites=true&w=majority&appName=Cluster0"

# Cloudinary (Settings → API Keys)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Superadmin login for /admin
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="use-a-long-random-password"

# Signs admin session cookies — 32+ random characters, e.g.
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""
