{
  "name": "nsude",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:migrate-variants": "tsx --env-file=.env prisma/migrate-variants.ts",
    "db:migrate-codes": "tsx --env-file=.env prisma/migrate-codes.ts && prisma db push --skip-generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.9",
    "jose": "^6.2.12",
    "lucide-react": "^0.451.0",
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.4.47",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3"
  }
